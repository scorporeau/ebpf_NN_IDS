@article{wang_design_2022,
	title = {Design and implementation of an intrusion detection system by using Extended {BPF} in the Linux kernel},
	volume = {198},
	issn = {10848045},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1084804521002769},
	doi = {10.1016/j.jnca.2021.103283},
	abstract = {An intrusion detection system ({IDS}) checks the content of headers and payload of packets to detect intrusions from the network. It is an essential function for network security. Traditionally, an {IDS}, such as Snort, which is a widely used open source {IDS}, is implemented as a program running in the user space on a hardware server. Recently, with the availability of Extended {BPF} ({eBPF}) in the Linux kernel, efficiently checking and filtering arriving packets directly in the kernel becomes feasible. In this work, we design and implement an {IDS} that has two parts working together. The first part runs in the Linux kernel. Its uses {eBPF} to perform fast patterns matching to pre-drop a very large portion of packets that have no chance to match any rule. The second part runs in the user space. It examines the packets left by the first part to find the rules that match them. Using a modified version of the registered ruleset of Snort, experimental results show that the maximum throughput of our {IDS} system can outperform that of Snort by a factor of 3 under many tested conditions.},
	pages = {103283},
	journaltitle = {Journal of Network and Computer Applications},
	shortjournal = {Journal of Network and Computer Applications},
	author = {Wang, Shie-Yuan and Chang, Jen-Chieh},
	urldate = {2026-03-18},
	date = {2022-02},
	langid = {english},
	keywords = {notion},
	file = {PDF:/home/sacha/snap/zotero-snap/common/Zotero/storage/WWLR9L4T/Wang and Chang - 2022 - Design and implementation of an intrusion detection system by using Extended BPF in the Linux kernel.pdf:application/pdf},
}

